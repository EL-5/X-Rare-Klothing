VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------
# Payment gateway secrets (Batch 12) — these are NOT VITE_ vars and do NOT
# go in this file's real .env.local. They must never reach the frontend.
# Set them on the Supabase project itself, for the initialize-payment and
# payment-webhook Edge Functions to read via Deno.env.get(...):
#
#   supabase secrets set PAYSTACK_SECRET_KEY=sk_test_...
#   supabase secrets set FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...
#   supabase secrets set FLUTTERWAVE_WEBHOOK_HASH=<a random string you also paste into the Flutterwave dashboard's webhook "secret hash" field>
#
# Use TEST/sandbox keys only until you're actually ready to take real
# payments (see Batch 12: "Use test/sandbox credentials only during
# development"). Then deploy the functions themselves:
#
#   supabase functions deploy initialize-payment
#   supabase functions deploy payment-webhook
#
# and register the webhook URLs in each provider's dashboard:
#   Paystack:     https://<project-ref>.supabase.co/functions/v1/payment-webhook?provider=paystack
#   Flutterwave:  https://<project-ref>.supabase.co/functions/v1/payment-webhook?provider=flutterwave
